!/data/external/.gitkeep
!/data/local/.gitkeep

# Reports and temp outputs
/backtesting/reports/*
!/backtesting/reports/.gitkeep
/tools/external/*
!/tools/external/.gitkeep
.tmp/
.yfinance-cache/
.streamlit/secrets.toml
.DS_Store
Thumbs.db
