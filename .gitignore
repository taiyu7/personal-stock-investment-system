# 本機設定覆寫
.env
*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
npm-debug.log*
pnpm-lock.yaml

# Data artifacts
/data/raw/*
/data/processed/*
/data/external/*
/data/local/*
