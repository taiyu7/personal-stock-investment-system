# 環境設定範本

# general
APP_ENV=local
LOG_LEVEL=info
TIMEZONE=Asia/Taipei

# database
# Default is a local SQLite file. MySQL/PostgreSQL can be added later.
DATABASE_URL=sqlite:///data/local/personal-stock-investment.db

# market data
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# ai clients
# OpenAI API key:
# 1. Go to https://platform.openai.com/api-keys
# 2. Create a project API key.
# 3. Copy this file to `.env` and paste the key below.
# Keep `.env` local only; never commit real API keys.
OPENAI_API_KEY=
OPENAI_RESEARCH_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_VLM_MODEL=gpt-4.1-mini
# true: allow OpenAI research analysis to use web search and include source URLs in the report.
OPENAI_RESEARCH_ANALYSIS_WEB_SEARCH=true
OPENAI_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_CHUNK_LENGTH_SECONDS=180
OPENAI_AUDIO_OUTPUT_TOKEN_WARNING_THRESHOLD=2048
OPENAI_AUDIO_TRANSCRIPTION_PROMPT=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# safety
ENABLE_LIVE_TRADING=false
