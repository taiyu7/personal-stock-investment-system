# 環境設定範本

# general
APP_ENV=local
LOG_LEVEL=info
TIMEZONE=Asia/Taipei

# database
DATABASE_URL=postgresql://user:password@localhost:5432/personal_stock_system

# market data
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# ai clients
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# safety
ENABLE_LIVE_TRADING=false
